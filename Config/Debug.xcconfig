// Physical devices need a reachable server; localhost is the phone itself.
API_BASE_URL = https:/$()/financebuddy.tech
API_BASE_URL[sdk=iphonesimulator*] = http:/$()/localhost:3000
GOOGLE_IOS_CLIENT_ID = configure-ios-client.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID = configure-web-client.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.configure-ios-client
#include? "Local.xcconfig"
INFOPLIST_FILE = Config/Info-Debug.plist
